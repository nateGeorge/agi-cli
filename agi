#!/usr/bin/env bash
# agi-cli runtime — interactive session bootstrap
set +e

agi_audio_pid=""

agi_cleanup() {
  if [[ -n "${agi_audio_pid:-}" ]]; then
    kill "$agi_audio_pid" 2>/dev/null
    pkill -P "$agi_audio_pid" 2>/dev/null
    wait "$agi_audio_pid" 2>/dev/null
  fi
  tput cnorm 2>/dev/null || true
  stty echo icanon 2>/dev/null || true
}
# INT/TERM must exit: trapping replaces the default and would otherwise keep the loop running.
trap agi_cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

stty -echo icanon 2>/dev/null || true
tput civis 2>/dev/null || true

cols=$(tput cols 2>/dev/null || echo 80)
rows=$(tput lines 2>/dev/null || echo 24)
[[ "$cols" -lt 40 ]] && cols=80
[[ "$rows" -lt 15 ]] && rows=24

R=$(tput setaf 1 2>/dev/null || printf '')
G=$(tput setaf 2 2>/dev/null || printf '')
Y=$(tput setaf 3 2>/dev/null || printf '')
B=$(tput setaf 4 2>/dev/null || printf '')
M=$(tput setaf 5 2>/dev/null || printf '')
C=$(tput setaf 6 2>/dev/null || printf '')
W=$(tput setaf 7 2>/dev/null || printf '')
X=$(tput sgr0 2>/dev/null || printf '')
BD=$(tput bold 2>/dev/null || printf '')
RV=$(tput rev 2>/dev/null || printf '')

clear_screen() { printf '\033[2J\033[H'; }

# Repaint stream view without erasing the whole screen (avoids flicker vs. clear_screen).
stream_redraw_start() { printf '\033[H'; }

# Optional: pre-rendered frames as *.txt (see tools/gif_to_agi_frames.sh).
# Search order: AGI_FRAMES_DIR, then <script-dir>/frames (git checkout), then ~/.config/agi-cli/frames.
AGI_FRAME_FILES=()
AGI_FRAME_N=0

agi_frames_dir() {
  if [[ -n "${AGI_FRAMES_DIR:-}" ]]; then
    printf '%s' "$AGI_FRAMES_DIR"
    return 0
  fi
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -d "$script_dir/frames" ]]; then
    printf '%s' "$script_dir/frames"
    return 0
  fi
  printf '%s' "$HOME/.config/agi-cli/frames"
}

agi_init_frames() {
  local d
  d="$(agi_frames_dir)"
  AGI_FRAME_FILES=()
  AGI_FRAME_N=0
  [[ -d "$d" ]] || return 0
  local -a files
  shopt -s nullglob
  files=( "$d"/*.txt )
  shopt -u nullglob
  (( ${#files[@]} == 0 )) && return 0
  local sorted
  sorted=$(printf '%s\n' "${files[@]}" | LC_ALL=C sort)
  while IFS= read -r line; do
    [[ -n "$line" ]] && AGI_FRAME_FILES+=( "$line" )
  done <<< "$sorted"
  AGI_FRAME_N=${#AGI_FRAME_FILES[@]}
}

emit_dance_frame() {
  local i="$1"
  if (( AGI_FRAME_N > 0 )); then
    cat "${AGI_FRAME_FILES[$(( i % AGI_FRAME_N ))]}"
  else
    dance_frame_builtin "$(( i % 6 ))"
  fi
}

# Local audio only: AGI_AUDIO=file or ~/.config/agi-cli/audio.{ext} — no network fetch.
agi_resolve_audio_path() {
  local f d="$HOME/.config/agi-cli" x
  if [[ -n "${AGI_AUDIO:-}" && -f "$AGI_AUDIO" ]]; then
    printf '%s' "$AGI_AUDIO"
    return 0
  fi
  for x in m4a mp3 wav flac ogg aac opus; do
    f="$d/audio.$x"
    if [[ -f "$f" ]]; then
      printf '%s' "$f"
      return 0
    fi
  done
  return 1
}

agi_play_audio() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  if command -v mpv >/dev/null 2>&1; then
    mpv --no-video --really-quiet --loop=inf "$file" &
    agi_audio_pid=$!
    return 0
  fi
  if command -v ffplay >/dev/null 2>&1; then
    (
      while true; do
        ffplay -nodisp -autoexit -loglevel quiet "$file" 2>/dev/null || sleep 0.2
      done
    ) &
    agi_audio_pid=$!
    return 0
  fi
  if [[ "$(uname -s)" == Darwin ]] && command -v afplay >/dev/null 2>&1; then
    (
      while true; do
        afplay "$file" 2>/dev/null || sleep 0.5
      done
    ) &
    agi_audio_pid=$!
    return 0
  fi
  return 1
}

wave_line() {
  local t="$1" width="$2" i ch
  local chars=('~' '~' '░' '▒' '▓' '█' '▓' '▒' '░' '~')
  local n=${#chars[@]}
  for ((i=0; i<width; i++)); do
    ch="${chars[$(( (i + t) % n ))]}"
    printf '%s' "$ch"
  done
}

bar_fill() {
  local n="$1" i
  for ((i=0; i<n; i++)); do printf '#'; done
}

bar_empty() {
  local n="$1" i
  for ((i=0; i<n; i++)); do printf '.'; done
}

loading_phase() {
  local i pct nfilled
  local title="${BD}${C}╔══════════════════════════════════════════════════════════╗${X}"
  local sub="${M}  AGI ${W}—${M} Artificial General Intelligence ${W}—${M} bootstrap${X}"
  for ((i=0; i<45; i++)); do
    clear_screen
    printf '\n\n'
    printf '  %s\n' "$title"
    printf '  %s%s║%s\n' "${C}" "${BD}" "${X}"
    printf '  %s%s║%s  %s\n' "${C}" "${BD}" "${X}" "$sub"
    printf '  %s%s║%s\n' "${C}" "${BD}" "${X}"
    printf '  %s\n' "${C}╚══════════════════════════════════════════════════════════╝${X}"
    printf '\n'
    printf '  %s%sAGI neural substrate is now loading...%s\n' "${BD}" "${Y}" "${X}"
    printf '\n  '
    wave_line "$i" 58
    printf '\n\n'
    pct=$(( i * 100 / 44 ))
    nfilled=$(( pct / 4 ))
    printf '  %s[%s' "${G}" "$(bar_fill "$nfilled")"
    printf '%s' "$(bar_empty $((25 - nfilled)))"
    printf '%s] %3d%%%s\n' "${G}" "$pct" "${X}"
    printf '\n  %s%sInitializing weights...%s' "${BD}" "${W}" "${X}"
    case $((i % 4)) in
      0) printf ' |' ;;
      1) printf ' /' ;;
      2) printf ' -' ;;
      3) printf ' \\' ;;
    esac
    sleep 0.06
  done
}

glitch_phase() {
  local i j k r c noise='@#$%&*?/\\|{}[]!~^'
  for ((i=0; i<18; i++)); do
    clear_screen
    if (( i % 3 == 0 )); then printf '%s' "${RV}"; fi
    for ((j=0; j<rows; j++)); do
      for ((k=0; k<cols; k++)); do
        r=$((RANDOM % 100))
        if (( r < 35 )); then
          c=${noise:$((RANDOM % ${#noise})):1}
          printf '%s' "$c"
        elif (( r < 50 )); then
          printf '%s' "${R}█${X}"
        else
          printf ' '
        fi
      done
    done
    printf '%s' "${X}"
    sleep 0.035
  done
  clear_screen
  printf '\n\n  %s%sSIGNAL LOCKED%s\n' "${BD}" "${G}" "${X}"
  sleep 0.25
  clear_screen
}

